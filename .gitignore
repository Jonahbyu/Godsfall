# Godot 4+ specific ignores
.godot/
/android/

# Local run logs. `errors.log` and the session history are machine-local
# debugging output from tools/launch.ps1 and mean nothing on another checkout.
# `fixed-history.log` is kept: it is the record of past mistakes the workflow
# in CLAUDE.md tells you to read when a bug looks familiar.
logs/errors.log
logs/history/

# Export templates and build output. The Web build is generated by
# `tools/export-web.ps1` and published to the `gh-pages` branch, never committed
# to master — a 39MB wasm regenerated on every export does not belong in the
# history of a source branch, and docs/ is reserved for plans and specs.
build/
*.tpz

# Machine-local pin to wherever this machine keeps its Godot build. Written by
# tools/launch.ps1 on first run, so committing it only bakes one person's
# Downloads folder into everyone else's checkout.
tools/godot-path.txt

# Balance simulation output. Regenerable from scripts/core/BalanceSim.gd, and a
# 100k-game sample is ~16MB of CSV that means nothing on another checkout —
# same reasoning that keeps the web build out of the source branch.
logs/sim/
